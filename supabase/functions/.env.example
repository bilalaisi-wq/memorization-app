# EDGE FUNCTIONS ONLY. Never copy these names/values into VITE_* variables.
# Local serving: copy to .env.billing.local (gitignored); populate securely.
# Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to hosted functions.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_EXPLORER_MONTHLY_PRICE_ID=
STRIPE_EXPLORER_ANNUAL_PRICE_ID=
STRIPE_PATHFINDER_MONTHLY_PRICE_ID=
STRIPE_PATHFINDER_ANNUAL_PRICE_ID=
# Leave Guardian prices unset until its services and launch checks are ready.
STRIPE_GUARDIAN_MONTHLY_PRICE_ID=
STRIPE_GUARDIAN_ANNUAL_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
BILLING_SITE_URL=https://ayah-a-day.up.railway.app
# Optional exact extra browser origins, comma-separated; never '*'.
BILLING_ALLOWED_ORIGINS=
