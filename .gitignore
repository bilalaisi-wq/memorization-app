node_modules/
dist/
playwright-report/
test-results/
.env
.env.local
.env.*.local
# Premium source and media must never enter the static/public build.
.quran-private/
# Consented recitation evaluation recordings/transcripts stay outside Git.
.recitation-evaluation/
# Operator Python importer caches.
__pycache__/
*.pyc

# Native signing and operator-local configuration must never be committed.
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision
*.provisionprofile
native-signing/
android/keystore.properties
ios/ExportOptions.local.plist
native-output/
# Operator-generated public association files require real signing identities.
public/.well-known/apple-app-site-association
public/.well-known/assetlinks.json
