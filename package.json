{
  "name": "ayah-puzzle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config scripts/private-vite.config.mjs --host 0.0.0.0",
    "build": "vite build --config scripts/private-vite.config.mjs",
    "preview": "vite preview --config scripts/private-vite.config.mjs --host 0.0.0.0",
    "test": "playwright test",
    "test:billing": "deno test --allow-env --allow-read supabase/functions/_shared/billing_test.ts",
    "check:billing": "deno check supabase/functions/billing-checkout/index.ts supabase/functions/billing-portal/index.ts supabase/functions/billing-refresh/index.ts supabase/functions/billing-passages/index.ts supabase/functions/billing-webhook/index.ts supabase/functions/billing-close/index.ts",
    "test:content": "deno test --allow-env --allow-read supabase/functions/_shared/quran_test.ts",
    "check:content": "deno check supabase/functions/quran-content/index.ts",
    "test:recitation": "deno test --allow-env --allow-read supabase/functions/_shared/recitation_test.ts",
    "check:recitation": "deno check supabase/functions/recitation-compare/index.ts",
    "check:coach": "deno check supabase/functions/hifz-coach/index.ts",
    "test:coach": "deno test --allow-env --allow-read supabase/functions/_shared/coach_test.ts",
    "profile:cosmic": "node scripts/profile-cosmic.mjs",
    "check:cosmic-rollout": "node scripts/check-cosmic-rollout.mjs",
    "start": "node scripts/serve.mjs",
    "test:chronicles": "deno test --allow-env --allow-read supabase/functions/_shared/chronicles/handler_test.ts",
    "check:chronicles": "deno check supabase/functions/chronicles-content/index.ts",
    "audit:quran": "node scripts/audit-quran-manifest.mjs",
    "check:quran-audit": "node scripts/audit-quran-manifest.mjs --check",
    "test:quran-import": "playwright test tests/quran-import-pipeline.spec.js --config=playwright.regression.config.js --workers=1",
    "validate:quran-release": "node scripts/validate-quran-release.mjs",
    "audit:quran-release": "node scripts/quran-release-status.mjs",
    "stage:quran-batch": "python3 scripts/stage-quran-batches.py",
    "postbuild": "node scripts/write-build-info.mjs",
    "native:doctor": "node scripts/native-build.mjs doctor",
    "native:art": "node scripts/native-assets.mjs",
    "native:icons": "npm run native:art && capacitor-assets generate --ios --android",
    "native:sync": "node scripts/native-build.mjs sync",
    "native:check": "node scripts/native-build.mjs check",
    "native:links": "node scripts/native-links.mjs",
    "native:android:debug": "npm run native:sync && node scripts/native-build.mjs android-debug",
    "native:android:release": "npm run native:sync && node scripts/native-build.mjs android-release",
    "native:ios:debug": "npm run native:sync && node scripts/native-build.mjs ios-debug",
    "native:ios:release": "npm run native:sync && node scripts/native-build.mjs ios-release"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.56.0",
    "deno": "2.9.6",
    "sharp": "0.35.5",
    "stripe": "23.0.0",
    "typescript": "7.0.2",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "ts-fsrs": "5.4.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
